          },
          "model_version": {
            "type": "string",
            "title": "Model Version",
            "description": "Version of the model used.",
            "default": "v1.0"
          },
          "confidence_score": {
            "type": "number",
            "title": "Confidence Score",
            "description": "Model confidence, from 0.0 to 1.0."
          },
          "requires_human_review": {
            "type": "boolean",
            "title": "Requires Human Review",
            "description": "True if confidence is below the review threshold in thresholds.yaml."
          },
          "explanation": {
            "items": {
              "$ref": "#/components/schemas/PredictionFactor"
            },
            "type": "array",
            "title": "Explanation",
            "description": "Factors that explain the prediction."
          },
          "timestamp_wat": {
            "type": "string",
            "title": "Timestamp Wat",
