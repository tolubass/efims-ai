          },
          "disclaimer": {
            "type": "string",
            "title": "Disclaimer",
            "description": "Human-approval notice.",
            "default": "This is an AI-generated suggestion. Human review and approval is required before any action is taken on a case."
          },
          "severity_prediction": {
