              }
            ],
            "title": "Request Timestamp",
            "description": "When the request was made, e.g. '2026-09-23 14:52:15 WAT'."
          },
          "incident_id": {
            "type": "string",
            "title": "Incident Id",
            "description": "Incident ID, e.g. 'INC-0000042'."
          },
          "financial_exposure_ngn": {
            "type": "number",
            "minimum": 0.0,
            "title": "Financial Exposure Ngn",
            "description": "Estimated exposure in NGN."
          },
          "customer_impact_count": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Customer Impact Count",
            "description": "Number of customers affected."
          },
          "ongoing_threat": {
            "type": "boolean",
            "title": "Ongoing Threat"
          },
          "insider_involvement": {
            "type": "boolean",
            "title": "Insider Involvement"
          },
          "data_compromise": {
            "type": "boolean",
            "title": "Data Compromise"
          },
          "regulatory_relevance": {
            "type": "boolean",
            "title": "Regulatory Relevance"
          },
          "source": {
            "type": "string",
            "title": "Source",
            "description": "How the incident was received, e.g. 'Customer Complaint'."
          },
          "channel": {
            "type": "string",
            "title": "Channel",
            "description": "Banking channel involved, e.g. 'Mobile Banking'."
          },
          "incident_type": {
            "type": "string",
            "title": "Incident Type",
            "description": "Type of incident, e.g. 'Account Takeover'."
          },
          "reported_by_type": {
            "type": "string",
            "title": "Reported By Type",
            "description": "Who reported it, e.g. 'Customer'."
          },
          "narrative": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Narrative",
            "description": "Free-text description of the incident."
          },
          "narrative_length": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Narrative Length",
            "description": "Character count of the narrative; filled in automatically if omitted."
          }
        },
        "type": "object",
        "required": [
          "incident_id",
          "financial_exposure_ngn",
          "customer_impact_count",
          "ongoing_threat",
          "insider_involvement",
          "data_compromise",
          "regulatory_relevance",
          "source",
          "channel",
          "incident_type",
          "reported_by_type"
        ],
        "title": "SeverityRequest",
        "description": "Input for a severity prediction: the facts known at incident intake.",
        "example": {
          "channel": "Mobile Banking",
          "customer_impact_count": 3,
          "data_compromise": false,
          "financial_exposure_ngn": 4800000.0,
          "incident_id": "INC-0000042",
          "incident_type": "Account Takeover",
          "insider_involvement": false,
          "narrative": "Customer called to report unauthorised transfers",
          "ongoing_threat": true,
          "regulatory_relevance": true,
          "reported_by_type": "Customer",
          "source": "Customer Complaint"
        }
      },
      "SeverityResponse": {
        "properties": {
          "prediction_id": {
            "type": "string",
            "title": "Prediction Id",
